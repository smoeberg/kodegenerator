{
  "schema_version": 1,
  "contract_id": "dor-demo-installation-v1",
  "status": "implementation_present_certification_pending",
  "owner": "core-platform",
  "compose": {
    "file": "compose.demo.yml",
    "start_command": "docker compose -f compose.demo.yml up --build -d",
    "stop_command": "docker compose -f compose.demo.yml down",
    "project_name": "dor-demo"
  },
  "implementation": {
    "runtime_dockerfile": "docker/Dockerfile.runtime",
    "environment_example": ".env.demo.example",
    "migration_entrypoint": "scripts/entrypoint.sh",
    "certified": false
  },
  "runtime": {
    "environment": "demo",
    "production_equivalent_wiring": true,
    "allows_sqlite": false,
    "allows_process_local_queue": false,
    "allows_file_pipeline_state": false,
    "requires_non_root_containers": true,
    "requires_read_only_root_filesystem": true
  },
  "services": {
    "postgres": {
      "role": "canonical relational persistence and durable queue",
      "public": false,
      "healthcheck": true,
      "persistent_volumes": ["postgres-data"]
    },
    "minio": {
      "role": "S3-compatible artifact persistence",
      "public": false,
      "healthcheck": true,
      "persistent_volumes": ["object-data"]
    },
    "migrate": {
      "role": "single-run Alembic migration owner",
      "public": false,
      "healthcheck": false,
      "depends_on": ["postgres"]
    },
    "api": {
      "role": "canonical FastAPI control plane",
      "public": true,
      "host_port": 8000,
      "healthcheck": true,
      "depends_on": ["migrate", "postgres", "minio"]
    },
    "worker": {
      "role": "tenant-scoped durable execution worker pool",
      "public": false,
      "healthcheck": true,
      "depends_on": ["migrate", "postgres", "minio"]
    },
    "dashboard": {
      "role": "Streamlit control-plane GUI using canonical HTTP APIs",
      "public": true,
      "host_port": 8501,
      "healthcheck": true,
      "depends_on": ["api"]
    },
    "otel-collector": {
      "role": "telemetry collection",
      "public": false,
      "healthcheck": true
    }
  },
  "shared_boundaries": {
    "database": ["api", "worker", "migrate"],
    "artifact_store": ["api", "worker"],
    "database_queue": ["api", "worker"],
    "telemetry": ["api", "worker"]
  },
  "required_configuration": [
    "POSTGRES_PASSWORD",
    "MINIO_ROOT_USER",
    "MINIO_ROOT_PASSWORD",
    "DOR_ADMIN_PASSWORD",
    "DOR_ADMIN_ORGANIZATION_ID",
    "DOR_JWT_SIGNING_KEYS",
    "DOR_JWT_ACTIVE_KEY_ID",
    "DOR_AUTHORITY_SIGNING_KEY",
    "DOR_ENCRYPTION_KEY",
    "DOR_WORKER_CAPABILITIES",
    "DOR_WORKER_SERVICE_ID",
    "DOR_WORKER_CREDENTIAL"
  ],
  "forbidden_configuration": {
    "DATABASE_URL_prefixes": ["sqlite:"],
    "DOR_QUEUE_BACKEND_values": ["memory", "in-memory", "sqlite"],
    "placeholder_secret_fragments": ["change-me", "replace-with", "placeholder"]
  },
  "public_endpoints": {
    "api": "http://localhost:8000",
    "api_health": "http://localhost:8000/health",
    "api_readiness": "http://localhost:8000/health/ready",
    "api_docs": "http://localhost:8000/docs",
    "dashboard": "http://localhost:8501"
  },
  "certification": {
    "required_before_demo": true,
    "requires_clean_database_boot": true,
    "requires_restart_recovery": true,
    "requires_cross_tenant_denial": true,
    "requires_stale_worker_fencing": true,
    "requires_exactly_one_terminal_side_effect": true,
    "requires_live_dashboard_api": true,
    "requires_attested_release_gates": true
  }
}
