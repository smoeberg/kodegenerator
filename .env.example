# =====================================================================
# Digital Organization Runtime (DOR) - Environment Variables Configuration
# =====================================================================

# Database Configuration
DATABASE_URL=sqlite:///./dor_runtime.db
# For PostgreSQL in Production:
# DATABASE_URL=postgresql://dor_user:secure_password@localhost:5432/dor_db

# ---------------------------------------------------------------------
# LLM Provider API Keys (Used by Digital Employee AI Task Executors)
# ---------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Default Models
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_CODE_LLM_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------
# External Service Integrations (Used by Service Task Executors)
# ---------------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
JIRA_API_TOKEN=your_jira_token_here
SLACK_BOT_TOKEN=your_slack_bot_token_here

# ---------------------------------------------------------------------
# Monitoring & Telemetry
# ---------------------------------------------------------------------
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
