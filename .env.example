# =====================================================================
# Digital Organization Runtime (DOR) - Environment Variables
# =====================================================================

# Environment
DOR_ENV=development

# Database
DATABASE_URL=sqlite:///./dor_runtime.db
# Production example:
# DATABASE_URL=postgresql://dor_user:secure_password@localhost:5432/dor_db
# Optional separate database for shared HTTP principals. Production falls back
# to DATABASE_URL when this is unset.
DOR_IDENTITY_DATABASE_URL=

# API authentication (production principals are persisted in the database)
DOR_JWT_SECRET_KEY=replace-with-a-long-random-secret
DOR_JWT_ALGORITHM=HS256
# Rotation mode (preferred in production). When set, this replaces the single
# DOR_JWT_SECRET_KEY. Keep the old key during overlap, then add its ID to the
# revocation list after the maximum token lifetime has elapsed.
# DOR_JWT_SIGNING_KEYS={"2026-08":"replace-with-32-or-more-random-characters","2026-09":"replace-with-another-long-random-secret"}
# DOR_JWT_ACTIVE_KEY_ID=2026-09
# DOR_JWT_REVOKED_KEY_IDS=2026-07
DOR_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Authority signing key (required in production)
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DOR_AUTHORITY_SIGNING_KEY=

# Dashboard authentication and API-key encryption (required for dashboard)
DOR_ADMIN_USERNAME=admin
DOR_ADMIN_PASSWORD=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOR_ENCRYPTION_KEY=

# LLM providers (Phase 3+; optional for foundation runtime)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_CODE_LLM_MODEL=claude-3-5-sonnet-20241022
# Explicit model for the opt-in Project Audit Responses provider
DOR_PROJECT_AUDIT_MODEL=
# Explicit, fail-closed Implementation Agent provider configuration
DOR_IMPLEMENTATION_MODEL=
# Comma-separated exact resources; globs are rejected
DOR_IMPLEMENTATION_ALLOWED_RESOURCES=repository:smoeberg/kodegenerator
DOR_IMPLEMENTATION_MAX_FILES=8
DOR_IMPLEMENTATION_MAX_CHANGED_LINES=1000
DOR_IMPLEMENTATION_MAX_CONTEXT_ITEMS=200
DOR_IMPLEMENTATION_MAX_CONTEXT_BYTES=524288
DOR_IMPLEMENTATION_MAX_INPUT_BYTES=524288
DOR_IMPLEMENTATION_MAX_OUTPUT_BYTES=524288
# Absolute repository workspace and fixed patch verification toolchain
DOR_PATCH_WORKSPACE_ROOT=
DOR_PATCH_ALLOWED_TOOLS=python.ruff,python.pytest,python.compileall
DOR_PATCH_TOOL_TIMEOUT_SECONDS=300
DOR_PATCH_MAX_TOOL_OUTPUT_BYTES=262144
DOR_PATCH_MAX_FILE_BYTES=16777216
DOR_PATCH_MAX_WORKSPACE_FILES=20000
DOR_PATCH_MAX_WORKSPACE_BYTES=268435456
DOR_PATCH_APPLY_TIMEOUT_SECONDS=30

# Software-factory pipeline (AI, tests, Docker deployment, durable state)
DOR_PIPELINE_MODEL=
DOR_PIPELINE_WORKSPACE=
DOR_PIPELINE_TEST_COMMAND=python -m pytest -q
DOR_PIPELINE_DOCKER_REGISTRY=
# Optional URL template fields: {project_name}, {environment}, {target}, {image_tag}
DOR_PIPELINE_DEPLOY_URL=
DOR_PIPELINE_QUEUE_PATH=pipeline_tasks.db
DOR_PIPELINE_STATE_PATH=pipeline_state.json
# ReleaseExecutor -> GitPRPublisher (token is declared under integrations below)
DOR_PIPELINE_GITHUB_OWNER=
DOR_PIPELINE_GITHUB_REPO=
DOR_PIPELINE_GIT_REPO_ROOT=

# External integrations (optional)
GITHUB_PERSONAL_ACCESS_TOKEN=
# Registry credentials are consumed by docker login/credential helpers, not DOR payloads
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=

# Monitoring & telemetry (optional)
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------
# Redmine error ticketing (optional)
# ---------------------------------------------------------------------
# When set, exhausted self-healing loops and unrecoverable generation
# failures open tracking issues on the configured Redmine server.
# REDMINE_URL=https://redmine.example.com
# REDMINE_API_KEY=your-api-key
# REDMINE_PROJECT_ID=your-project-id
# REDMINE_ISSUE_TRACKER_ID=1
# REDMINE_MAX_ISSUES_PER_RUN=5
# REDMINE_DEDUP_WINDOW_DAYS=7
