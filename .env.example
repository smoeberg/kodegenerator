# Copy to .env for non-secret configuration and host paths only.
# Never place production secret VALUES in this file. The canonical compose stack
# mounts the files below through Docker Compose secrets and DOR materializes them
# only after the runtime process starts.

# PostgreSQL - non-secret identity plus operator-managed password file
POSTGRES_DB=dor
POSTGRES_USER=dor
DOR_SECRET_POSTGRES_PASSWORD_FILE=/etc/dor/secrets/postgres_password

# MinIO / artifact store credentials are file-backed
DOR_SECRET_MINIO_ROOT_USER_FILE=/etc/dor/secrets/minio_root_user
DOR_SECRET_MINIO_ROOT_PASSWORD_FILE=/etc/dor/secrets/minio_root_password
ARTIFACT_BUCKET=dor-artifacts
AWS_DEFAULT_REGION=eu-central-1

# Dashboard / bootstrap identity
DOR_ADMIN_USERNAME=admin
DOR_ADMIN_ORGANIZATION_ID=dor-org
DOR_SECRET_ADMIN_PASSWORD_FILE=/etc/dor/secrets/dor_admin_password

# Preferred Project Audit repository catalog for the optional Compose override.
# Both host paths are mounted read-only by compose.project-audit.yml.
DOR_PROJECT_AUDIT_CHECKOUTS_HOST_ROOT=/srv/dor/audit-checkouts
DOR_PROJECT_AUDIT_CHECKOUT_CATALOG_HOST_FILE=/etc/dor/project-audit-checkouts.json

# Non-Compose deployments set these paths INSIDE the dashboard process/container.
# The checkout catalog contains relative checkout names under the trusted root.
DOR_PROJECT_AUDIT_CHECKOUTS_ROOT=/audit/checkouts
DOR_PROJECT_AUDIT_CHECKOUT_CATALOG=/audit/catalog.json

# Legacy optional single-checkout binding. Used only when catalog mode above is absent.
# The checkout root must point at a dedicated clean Git checkout mounted read-only.
DOR_PROJECT_AUDIT_ORGANIZATION_ID=dor-org
DOR_PROJECT_AUDIT_REPOSITORY=repository:example/project
DOR_PROJECT_AUDIT_CHECKOUT_ROOT=/audit/repository

# Governed Implementation Agent (API process only).
# Provider credentials are deployment secrets. A platform-specific deployment may
# mount one and expose only OPENAI_API_KEY_FILE inside the API container.
DOR_IMPLEMENTATION_MODEL=replace-with-approved-model-id
DOR_IMPLEMENTATION_ALLOWED_RESOURCES=repository:example/project
DOR_PATCH_WORKSPACE_ROOT=/workspace/project
DOR_PATCH_ALLOWED_TOOLS=python.ruff,python.pytest,python.compileall

# JWT keyring. The active key id is non-secret; the keyring value is file-backed.
DOR_JWT_ACTIVE_KEY_ID=dor-2026-09
DOR_SECRET_JWT_SIGNING_KEYS_FILE=/etc/dor/secrets/dor_jwt_signing_keys

# Authority & encryption key material
DOR_SECRET_AUTHORITY_SIGNING_KEY_FILE=/etc/dor/secrets/dor_authority_signing_key
DOR_SECRET_ENCRYPTION_KEY_FILE=/etc/dor/secrets/dor_encryption_key

# Worker Configuration
DOR_ORGANIZATION_ID=dor-org
DOR_WORKER_SERVICE_ID=factory-worker
DOR_SECRET_WORKER_CREDENTIAL_FILE=/etc/dor/secrets/dor_worker_credential
DOR_WORKER_CAPABILITIES=pipeline.architecture,pipeline.code,pipeline.contracts,pipeline.deploy,pipeline.release,pipeline.tests
DOR_WORKER_REPLICAS=2

# API & Dashboard
DOR_API_PORT=8000
DOR_DASHBOARD_PORT=8501

# Redmine integration metadata. REDMINE_API_KEY is a deployment secret and must
# be provided as REDMINE_API_KEY_FILE by a platform-specific API deployment.
REDMINE_URL=https://redmine.example.invalid
REDMINE_PROJECT_ID=replace-with-redmine-project-identifier

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
