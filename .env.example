# Copy to .env and replace every generated-* value before starting the system.
# Values here are non-functional documentation placeholders.
POSTGRES_DB=dor
POSTGRES_USER=dor
POSTGRES_PASSWORD=generated-url-safe-postgres-password

MINIO_ROOT_USER=generated-minio-user
MINIO_ROOT_PASSWORD=generated-minio-password-at-least-16-characters
ARTIFACT_BUCKET=dor-artifacts

DOR_ADMIN_USERNAME=admin
DOR_ADMIN_ORGANIZATION_ID=dor-org
DOR_ADMIN_PASSWORD=generated-dashboard-password
DOR_JWT_SIGNING_KEYS={"dor-2026-09":"generated-jwt-key-at-least-32-characters"}
DOR_JWT_ACTIVE_KEY_ID=dor-2026-09
DOR_AUTHORITY_SIGNING_KEY=generated-authority-key-at-least-32-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOR_ENCRYPTION_KEY=generated-valid-fernet-key

DOR_ORGANIZATION_ID=dor-org
DOR_WORKER_SERVICE_ID=factory-worker
DOR_WORKER_CREDENTIAL=generated-worker-credential-at-least-32-characters
DOR_WORKER_CAPABILITIES=pipeline.architecture,pipeline.code,pipeline.contracts,pipeline.deploy,pipeline.release,pipeline.tests
DOR_WORKER_REPLICAS=2
DOR_API_PORT=8000
DOR_DASHBOARD_PORT=8501
