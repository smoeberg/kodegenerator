# =====================================================================
# Digital Organization Runtime (DOR) - Environment Variables
# =====================================================================

# Database
DATABASE_URL=sqlite:///./dor_runtime.db
# Production example:
# DATABASE_URL=postgresql://dor_user:secure_password@localhost:5432/dor_db

# API authentication (required when starting the API)
DOR_JWT_SECRET_KEY=replace-with-a-long-random-secret
DOR_JWT_ALGORITHM=HS256
DOR_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dashboard authentication and API-key encryption (required for dashboard)
DOR_ADMIN_USERNAME=admin
DOR_ADMIN_PASSWORD=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOR_ENCRYPTION_KEY=

# LLM providers (Phase 3+; optional for foundation runtime)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_CODE_LLM_MODEL=claude-3-5-sonnet-20241022
# Explicit model for the opt-in Project Audit Responses provider
DOR_PROJECT_AUDIT_MODEL=
# Explicit, fail-closed Implementation Agent provider configuration
DOR_IMPLEMENTATION_MODEL=
# Comma-separated exact resources; globs are rejected
DOR_IMPLEMENTATION_ALLOWED_RESOURCES=repository:smoeberg/kodegenerator
DOR_IMPLEMENTATION_MAX_FILES=8
DOR_IMPLEMENTATION_MAX_CHANGED_LINES=1000
DOR_IMPLEMENTATION_MAX_CONTEXT_ITEMS=200
DOR_IMPLEMENTATION_MAX_CONTEXT_BYTES=524288
DOR_IMPLEMENTATION_MAX_INPUT_BYTES=524288
DOR_IMPLEMENTATION_MAX_OUTPUT_BYTES=524288
# Absolute repository workspace and fixed patch verification toolchain
DOR_PATCH_WORKSPACE_ROOT=
DOR_PATCH_ALLOWED_TOOLS=python.ruff,python.pytest,python.compileall
DOR_PATCH_TOOL_TIMEOUT_SECONDS=300
DOR_PATCH_MAX_TOOL_OUTPUT_BYTES=262144
DOR_PATCH_MAX_FILE_BYTES=16777216
DOR_PATCH_MAX_WORKSPACE_FILES=20000
DOR_PATCH_MAX_WORKSPACE_BYTES=268435456
DOR_PATCH_APPLY_TIMEOUT_SECONDS=30

# External integrations (optional)
GITHUB_PERSONAL_ACCESS_TOKEN=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=

# Monitoring & telemetry (optional)
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
