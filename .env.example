# Copy to .env and replace every generated-* value before starting the system.
# Values here are non-functional documentation placeholders.
# Single source of truth: Set POSTGRES_DB, POSTGRES_USER, and POSTGRES_PASSWORD once,
# and all database URLs are automatically constructed from these values.

# PostgreSQL - Single source of truth (set these ONCE)
POSTGRES_DB=dor
POSTGRES_USER=dor
POSTGRES_PASSWORD=generated-url-safe-postgres-password

# MinIO
MINIO_ROOT_USER=generated-minio-user
MINIO_ROOT_PASSWORD=generated-minio-password-at-least-16-characters
ARTIFACT_BUCKET=dor-artifacts
AWS_DEFAULT_REGION=eu-central-1

# Dashboard
DOR_ADMIN_USERNAME=admin
DOR_ADMIN_ORGANIZATION_ID=dor-org
DOR_ADMIN_PASSWORD=generated-dashboard-password

# Preferred Project Audit repository catalog for the optional Compose override.
# Both host paths are mounted read-only by compose.project-audit.yml.
DOR_PROJECT_AUDIT_CHECKOUTS_HOST_ROOT=/srv/dor/audit-checkouts
DOR_PROJECT_AUDIT_CHECKOUT_CATALOG_HOST_FILE=/etc/dor/project-audit-checkouts.json

# Non-Compose deployments set these paths INSIDE the dashboard process/container.
# The checkout catalog contains relative checkout names under the trusted root.
DOR_PROJECT_AUDIT_CHECKOUTS_ROOT=/audit/checkouts
DOR_PROJECT_AUDIT_CHECKOUT_CATALOG=/audit/catalog.json

# Legacy optional single-checkout binding. Used only when catalog mode above is absent.
# The checkout root must point at a dedicated clean Git checkout mounted read-only.
DOR_PROJECT_AUDIT_ORGANIZATION_ID=dor-org
DOR_PROJECT_AUDIT_REPOSITORY=repository:example/project
DOR_PROJECT_AUDIT_CHECKOUT_ROOT=/audit/repository

# JWT Configuration
DOR_JWT_SECRET_KEY=generated-jwt-secret-at-least-32-characters
DOR_JWT_SIGNING_KEYS={"dor-2026-09":"generated-jwt-key-at-least-32-characters"}
DOR_JWT_ACTIVE_KEY_ID=dor-2026-09

# Authority & Security
DOR_AUTHORITY_SIGNING_KEY=generated-authority-key-at-least-32-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOR_ENCRYPTION_KEY=generated-valid-fernet-key

# Worker Configuration
DOR_ORGANIZATION_ID=dor-org
DOR_WORKER_SERVICE_ID=factory-worker
DOR_WORKER_CREDENTIAL=generated-worker-credential-at-least-32-characters
DOR_WORKER_CAPABILITIES=pipeline.architecture,pipeline.code,pipeline.contracts,pipeline.deploy,pipeline.release,pipeline.tests
DOR_WORKER_REPLICAS=2

# API & Dashboard
DOR_API_PORT=8000
DOR_DASHBOARD_PORT=8501

# Redmine integration (API process only; never expose REDMINE_API_KEY to the dashboard/browser)
REDMINE_URL=https://redmine.example.invalid
REDMINE_API_KEY=generated-redmine-api-key
REDMINE_PROJECT_ID=replace-with-redmine-project-identifier

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
