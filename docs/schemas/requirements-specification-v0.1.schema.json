{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smoeberg/kodegenerator/blob/main/docs/schemas/requirements-specification-v0.1.schema.json",
  "title": "Kodegenerator Requirements Specification v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specification_id",
    "project",
    "version",
    "status",
    "intent",
    "stakeholders",
    "actors",
    "functional_requirements",
    "non_functional_requirements",
    "business_rules",
    "data_requirements",
    "integration_requirements",
    "security_requirements",
    "compliance_requirements",
    "constraints",
    "acceptance_criteria",
    "assumptions",
    "open_questions",
    "traceability",
    "approval"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "specification_id": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "status": {
      "enum": ["draft", "clarification_required", "review", "approved", "superseded", "rejected"]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_statement", "desired_outcome"],
      "properties": {
        "problem_statement": { "type": "string", "minLength": 1 },
        "desired_outcome": { "type": "string", "minLength": 1 },
        "scope_summary": { "type": "string" },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "success_definition": { "type": "string" }
      }
    },
    "stakeholders": { "type": "array", "items": { "$ref": "#/$defs/stakeholder" } },
    "actors": { "type": "array", "items": { "$ref": "#/$defs/actor" } },
    "functional_requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "non_functional_requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "business_rules": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "data_requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "integration_requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "security_requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "compliance_requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "acceptance_criteria": { "type": "array", "items": { "$ref": "#/$defs/acceptance" } },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "open_questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "traceability": { "type": "array", "items": { "$ref": "#/$defs/trace" } },
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "stakeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "concerns"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "concerns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "goals"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "goals": { "type": "array", "items": { "type": "string" } },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "priority", "source", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["must", "should", "could", "wont"] },
        "source": { "enum": ["human", "conversation", "imported", "agent_proposed", "system_derived"] },
        "status": { "enum": ["proposed", "confirmed", "rejected", "superseded"] },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "confirmed", "rejected", "superseded"] },
        "requirement_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source", "confidence", "requires_confirmation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "requires_confirmation": { "type": "boolean" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "blocking", "owner", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved", "deferred"] },
        "resolution": { "type": "string" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "architecture_ids": { "type": "array", "items": { "type": "string" } },
        "contract_ids": { "type": "array", "items": { "type": "string" } },
        "task_ids": { "type": "array", "items": { "type": "string" } },
        "artifact_ids": { "type": "array", "items": { "type": "string" } },
        "test_ids": { "type": "array", "items": { "type": "string" } },
        "audit_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "specification_id": { "type": "string" },
        "version": { "type": "string" },
        "fingerprint": { "type": "string" },
        "approver_id": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "validation_result": { "type": "string" },
        "unresolved_non_blocking_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
