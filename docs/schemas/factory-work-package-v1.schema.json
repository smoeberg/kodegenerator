{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smoeberg/kodegenerator/blob/main/docs/schemas/factory-work-package-v1.schema.json",
  "title": "DOR Factory Work Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "work_package_id", "organization_id", "workflow_id",
    "logical_task_id", "repository", "base_sha", "requirements_fingerprint",
    "architecture_fingerprint", "contract_fingerprints", "dependencies",
    "acceptance_criteria", "write_scope", "execution_mode", "candidate_count",
    "role_allocation_id", "selection_policy_id", "risk_level",
    "idempotency_key", "fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "work_package_id": { "$ref": "#/$defs/id" },
    "organization_id": { "$ref": "#/$defs/id" },
    "workflow_id": { "$ref": "#/$defs/id" },
    "logical_task_id": { "$ref": "#/$defs/id" },
    "repository": { "type": "string", "minLength": 1 },
    "base_sha": { "$ref": "#/$defs/sha1" },
    "requirements_fingerprint": { "$ref": "#/$defs/sha256" },
    "architecture_fingerprint": { "$ref": "#/$defs/sha256" },
    "contract_fingerprints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "description", "required_checks"],
        "properties": {
          "criterion_id": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 1 },
          "required_checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "write_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "denied_paths"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "denied_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "execution_mode": {
      "enum": ["single", "parallel_components", "competing_candidates"]
    },
    "candidate_count": { "type": "integer", "minimum": 1, "maximum": 100 },
    "role_allocation_id": { "$ref": "#/$defs/id" },
    "selection_policy_id": { "$ref": "#/$defs/id" },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 1 },
        "max_cost_minor_units": { "type": "integer", "minimum": 0 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "idempotency_key": { "$ref": "#/$defs/id" },
    "fingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9_./*?\\[\\]-]+$"
    }
  }
}

